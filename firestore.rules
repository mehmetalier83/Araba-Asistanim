rules_version = '2';

// Araba Asistanım: every user can only read and write their own garage,
// stored under users/{uid}/{vehicles|fuelRecords|maintenanceRecords|expenses}/{id}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && collection in ['vehicles', 'fuelRecords', 'maintenanceRecords', 'expenses'];
    }
  }
}
